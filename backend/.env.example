# Afterglow — example configuration (English)
# Chinese comments: .env.example.zh-CN; both templates use identical keys and values.
# Copy either template to .env in the backend working directory.
# Never commit .env. Fully restart the backend after changing it.
# Process environment variables override this file.
# Reference: https://kldhsh123.github.io/Afterglow/en/environment.html
# Empty auxiliary-model fields reuse their documented fallback chain.
# Base URLs include provider paths such as /v1, without /chat/completions or /responses.
# Exported histories can reveal account IDs: confirm self/friend identities in the wizard.
# Model calls may send chat content to your configured provider; review the privacy guide.


# ----- Application, identity and relationship -----
# Your display name; required identity setting.
SELF_NAME=
# Your platform UID; comma-separated accounts are supported.
SELF_UID=
# Target person's display name; required identity setting.
FRIEND_NAME=
# Target person's platform UID; comma-separated accounts are supported.
FRIEND_UID=
# Legacy multiple-UID list; prefer comma-separated SELF_UID.
SELF_UIDS=
# Legacy friend UID list; prefer FRIEND_UID.
FRIEND_UIDS=
# Your real name, usernames, nicknames and aliases, comma-separated.
SELF_ALIASES=
# Target person's aliases for cleaning, retrieval and prompt identity matching.
FRIEND_ALIASES=
# One of friend, lover, family, colleague, custom.
RELATIONSHIP_TYPE=friend
# Free-form relationship description; required for custom, optionally overrides defaults otherwise.
RELATIONSHIP_DESCRIPTION=

# ----- Main chat model -----
# Main chat model API key.
OPENAI_API_KEY=
# OpenAI-compatible base URL; include the required provider path (such as /v1), without /chat/completions or /responses.
OPENAI_BASE_URL=https://api.openai.com/v1
# Final reply model; code fallback without .env is gpt-4o-mini.
CHAT_MODEL=gpt-4o
# Main upstream protocol: chat_completions or responses; auxiliary models are unaffected.
CHAT_API_PROTOCOL=chat_completions
# Main chat request timeout in seconds; greater than zero.
CHAT_TIMEOUT_SECONDS=60
# Reasoning effort for compatible LLMs: none, low, medium, high, xhigh; null omits the field. Applies to chat, Life, policy, schedules, rewrite, adaptive chunking, labels and VLM; not embeddings/search/rerank.
LLM_REASONING_EFFORT=null

# ----- Life-state model -----
# Life-state model base URL; empty reuses the main model.
LIFE_API_URL=
# Life-state API key; empty reuses the main model key.
LIFE_API_KEY=
# Model maintaining life_state.json; empty uses CHAT_MODEL.
LIFE_MODEL=
# State JSON generation temperature, 0..2.
LIFE_TEMPERATURE=0.35
# Maximum state JSON output tokens; allow room for reasoning on thinking models.
LIFE_MAX_TOKENS=1500
# Life-state request timeout in seconds; greater than zero.
LIFE_TIMEOUT_SECONDS=30
# Maximum interval before state reevaluation; 0 uses events and next_update_at only.
LIFE_UPDATE_INTERVAL_MINUTES=60
# Maximum suggested reply presentation delay.
LIFE_MAX_REPLY_DELAY_SECONDS=45
# Minimum fallback delay while sleeping; 0 disables it.
LIFE_SLEEPING_MIN_REPLY_DELAY_SECONDS=8
# Normalize and strip main-model <life-event> asynchronously; legacy <life-update> input is accepted. false still strips markers.
LIFE_MARKER_UPDATE_ENABLED=true

# ----- Response policy model -----
# Enable bounded small-model refinement after rule-based policy.
RESPONSE_POLICY_MODEL_ENABLED=false
# Policy model URL; empty reuses Life/main chain.
RESPONSE_POLICY_API_URL=
# Policy API key; empty reuses Life/main chain.
RESPONSE_POLICY_API_KEY=
# Policy model name; empty reuses Life/main chain.
RESPONSE_POLICY_MODEL=
# Policy output temperature.
RESPONSE_POLICY_TEMPERATURE=0.2
# Maximum policy JSON output tokens.
RESPONSE_POLICY_MAX_TOKENS=260
# Policy timeout in seconds; greater than zero.
RESPONSE_POLICY_TIMEOUT_SECONDS=8

# ----- Output, silence and Responses API -----
# Response content marker when the policy chooses silence.
SILENCE_RESPONSE_SENTINEL=[silent]
# silenced or stop; use stop for strict OpenAI SDK enums.
SILENCE_FINISH_REASON=silenced
# Allow model-chosen silence in low-risk situations; does not disable rule-based safety silence.
AI_SILENCE_ENABLED=true
# false sends complete text over simulated SSE; true enables real streaming.
RESPONSE_STREAMING_ENABLED=false

# ----- Long-conversation summaries -----
# Enable long-conversation summaries; disabling sends the full history.
CONVERSATION_SUMMARY_ENABLED=true
# Update when the combined character count of unsummarized history and existing summary exceeds this value.
CONVERSATION_SUMMARY_TRIGGER_CHARS=16000
# Update when unsummarized historical messages exceed this count.
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=40
# Maximum recent original messages retained after compression.
CONVERSATION_SUMMARY_KEEP_MESSAGES=16
# Recent-message character budget; keeps whole messages and tries to preserve question/answer pairs.
CONVERSATION_SUMMARY_RECENT_CHARS=8000
# Maximum summary characters.
CONVERSATION_SUMMARY_MAX_CHARS=3000
# New source characters per summary call; very long messages are processed in batches.
CONVERSATION_SUMMARY_BATCH_CHARS=12000
# Total timeout budget for a summary update; must be finite and positive.
CONVERSATION_SUMMARY_TIMEOUT_SECONDS=30

# ----- Output, silence and Responses API -----
# In-process LRU capacity mapping previous_response_id to conversation_id; lost on restart.
RESPONSES_STORE_CAPACITY=512

# ----- Proactive messages (experimental) -----
# Runtime proactive-message switch; currently not recommended for production.
PROACTIVE_ENABLED=false
# Minimum silence gap used to recognize a new conversation opening.
PROACTIVE_LEARNING_MIN_GAP_MINUTES=120
# Minimum proactive trigger score.
PROACTIVE_SCORE_THRESHOLD=0.55
# Suggested polling interval for clients/schedulers.
PROACTIVE_CHECK_INTERVAL_SECONDS=900
# Minimum current-conversation idle time.
PROACTIVE_MIN_IDLE_MINUTES=180
# Maximum proactive messages per conversation/day; 0 prohibits sending.
PROACTIVE_MAX_PER_DAY=1
# Quiet interval, including overnight ranges; empty disables it.
PROACTIVE_QUIET_HOURS=00:00-08:30
# Skip initiation when Life state is busy, sleeping or away.
PROACTIVE_SKIP_WHEN_LIFE_BUSY=true
# Recent dialogue-window limit for profile fallback reconstruction.
PROACTIVE_PROFILE_WINDOW_LIMIT=10000
# In-memory proactive audit record window.
PROACTIVE_AUDIT_MAX_RECORDS=200
# Keep short recent context per caller/conversation.
PROACTIVE_CONTEXT_CACHE_ENABLED=true
# Maximum cached messages per conversation.
PROACTIVE_CONTEXT_CACHE_MAX_ITEMS=40
# Maximum cached messages injected into proactive generation.
PROACTIVE_CONTEXT_CACHE_PROMPT_ITEMS=12
# Maximum characters per cached message.
PROACTIVE_CONTEXT_CACHE_MAX_TEXT_CHARS=240

# ----- Embeddings -----
# OpenAI-compatible embedding base URL; include provider path, without /embeddings.
EMBEDDING_API_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
# Embedding service key.
EMBEDDING_API_KEY=
# Embedding model name.
EMBEDDING_MODEL=xop3qwen8bembedding
# Model output and LanceDB schema dimension; positive and identical. Rebuild existing vectors after changes; see Troubleshooting.
EMBEDDING_DIM=4096
# Embedding timeout in seconds; greater than zero.
EMBEDDING_TIMEOUT_SECONDS=60
# array for standard batches, single for one input at a time.
EMBEDDING_INPUT_MODE=array
# Maximum texts per request; forced to 1 in single mode.
EMBEDDING_BATCH_SIZE=25
# Maximum in-flight HTTP requests; greater than zero.
EMBEDDING_MAX_CONCURRENCY=20
# Request cap per minute; 0 means no client-side cap.
EMBEDDING_MAX_REQUESTS_PER_MINUTE=0
# Send encoding_format=float; disable for incompatible gateways.
EMBEDDING_INCLUDE_ENCODING_FORMAT=true
# Send dimensions; usually needed with MRL models.
EMBEDDING_SEND_DIMENSIONS=true
# Total attempts including the first request.
EMBEDDING_RETRY_ATTEMPTS=8
# Maximum single exponential-backoff delay.
EMBEDDING_RETRY_MAX_WAIT_SECONDS=10
# Stop import after this many consecutive exhausted embedding requests.
EMBEDDING_MAX_CONSECUTIVE_FAILURES=3

# ----- Application, identity and relationship -----
# Application name shown by the API and frontend.
APP_NAME=Afterglow
# Application subtitle; the existing configured/default text is preserved, not auto-translated.
APP_SLOGAN=把曾经对你好的话，续成往后的陪伴
# IANA time zone supplied to models; affects real time, circadian patterns and schedules.
APP_TIMEZONE=Asia/Shanghai
# Backend default and proactive-message language: en or zh-CN. CLI --language overrides command output; ordinary HTTP uses Accept-Language when supported. Proactive output always follows this setting. Restart after changes.
XUWEN_LANGUAGE=en

# ----- Storage, authentication, configuration UI and privacy -----
# Redact phone numbers, emails, identity documents, bank cards and IPs before storage.
ENABLE_PII_REDACTION=true
# Custom YAML/JSON redaction rules; empty means unset.
PII_RULES_PATH=

# ----- Vision and historical images -----
# Enable vision, including offline historical-image description.
VISION_ENABLED=false
# Whether the main model accepts OpenAI multimodal image content directly.
CHAT_MODEL_SUPPORTS_VISION=false
# Independent VLM base URL when the main model lacks vision; always needed for historical-image import.
VISION_API_URL=
# Independent VLM key.
VISION_API_KEY=
# Independent VLM model.
VISION_MODEL=qwen-vl-plus
# Image-to-text instruction; a custom prompt is preserved as supplied.
VISION_DESCRIBE_PROMPT=请用一两句话客观描述这张图片的内容，不要发挥。
# Online chat/responses VLM description budget in seconds; positive. Does not change VisionClient's default 60-second HTTP timeout.
VISION_TIMEOUT_SECONDS=15
# Maximum bytes per image; default 8 MiB.
VISION_MAX_IMAGE_BYTES=8388608

# ----- Web search and page fetching -----
# Master web switch; false disables search and URL fetching.
WEB_ACCESS_ENABLED=false
# tavily or searxng.
WEB_SEARCH_PROVIDER=tavily
# Search service base URL.
WEB_SEARCH_BASE_URL=https://api.tavily.com
# Search key; often unnecessary for SearXNG.
WEB_SEARCH_API_KEY=
# Requested result count; capped at 10 by code.
WEB_SEARCH_MAX_RESULTS=5
# Search timeout in seconds; nonnegative.
WEB_SEARCH_TIMEOUT_SECONDS=8
# Search language hint; independent of backend output language.
WEB_SEARCH_LANGUAGE=zh-CN
# Fetch user-supplied public URLs; still requires web master switch.
WEB_FETCH_ENABLED=true
# Per-page fetch timeout in seconds.
WEB_FETCH_TIMEOUT_SECONDS=8
# Maximum fetched URLs per turn; capped at 5.
WEB_FETCH_MAX_URLS=2
# Maximum redirects; capped at 10.
WEB_FETCH_MAX_REDIRECTS=3
# Maximum page download size; capped at 2 MiB.
WEB_FETCH_MAX_BYTES=524288
# Maximum page characters injected into the prompt; capped at 20000.
WEB_FETCH_MAX_CHARS=6000

# ----- Storage, authentication, configuration UI and privacy -----
# LanceDB directory.
LANCE_DB_PATH=.data/lancedb
# Persona, circadian, Life state and proactive profile directory.
PERSONA_DATA_DIR=.data/persona
# Timeline, personality, block cache and isolated experimental output directory.
ANALYSIS_DATA_DIR=.data/analysis

# ----- Vision and historical images -----
# Directory for original images stored by SHA-256.
IMAGE_DATA_DIR=.data/images

# ----- Stickers -----
# Directory for sticker originals and index.json.
STICKER_DATA_DIR=.data/stickers
# Maximum available stickers shown to the main model.
STICKER_MAX_FOR_AI=30
# Maximum bytes per sticker; default 2 MiB.
STICKER_MAX_IMAGE_BYTES=2097152
# Retry once when a non-streaming reply selects a nonexistent sticker.
STICKER_REJECT_RETRY=true

# ----- API authentication matrix -----
# Result
API_AUTH_REQUIRED=true

# ----- Storage, authentication, configuration UI and privacy -----
# Bearer/x-api-key access password; any nonempty value always enables validation.
XUWEN_API_KEY=
# Explicitly mount the wizard; missing critical settings may also enable it automatically.
CONFIG_UI_ENABLED=false
# Wizard path; must begin with / and avoid overlapping business API prefixes.
CONFIG_UI_PATH_PREFIX=/config
# Restrict the configuration UI to local clients.
CONFIG_UI_LOCALHOST_ONLY=true
# Separate setup token; empty generates a random session token at startup.
CONFIG_UI_SETUP_TOKEN=
# Temporary directory for wizard uploads.
CONFIG_UI_UPLOADS_DIR=.data/uploads

# ----- Update checks -----
# Query the latest release at startup.
UPDATE_CHECK_ENABLED=true
# Public release lookup URL.
UPDATE_CHECK_URL=https://api.github.com/repos/kldhsh123/Afterglow/releases/latest
# Update-check timeout in seconds.
UPDATE_CHECK_TIMEOUT_SECONDS=8

# ----- Application, identity and relationship -----
# Built-in xuwen/friend/lover/family/colleague or an absolute custom .md.j2 path.
PERSONA_TEMPLATE=xuwen
# Override the built-in template directory; empty means unset.
PROMPT_TEMPLATE_DIR=

# ----- Chat splitting -----
# fixed windows or adaptive topic-based splitting.
CHUNKING_STRATEGY=fixed
# Start a new session when adjacent messages exceed this gap.
SESSION_GAP_MINUTES=30
# Messages per fixed multi-turn window.
WINDOW_SIZE=12
# Overlap between windows; must be strictly less than WINDOW_SIZE.
WINDOW_OVERLAP=3
# Context messages before a standalone friend message.
SINGLE_CONTEXT_BEFORE=6
# Context messages after a standalone friend message.
SINGLE_CONTEXT_AFTER=2
# Adaptive-mode character budget for a message's embedding context.
SINGLE_CONTEXT_MAX_CHARS=600
# Use a small model for adaptive topic boundaries.
ADAPTIVE_CHUNK_MODEL_ENABLED=false
# Chunking model URL; empty follows the fallback chain.
ADAPTIVE_CHUNK_API_URL=
# Chunking model key.
ADAPTIVE_CHUNK_API_KEY=
# Chunking model name.
ADAPTIVE_CHUNK_MODEL=
# Boundary output temperature, 0..2.
ADAPTIVE_CHUNK_TEMPERATURE=0
# Maximum boundary JSON output tokens.
ADAPTIVE_CHUNK_MAX_TOKENS=900
# Adaptive chunking timeout in seconds; positive.
ADAPTIVE_CHUNK_TIMEOUT_SECONDS=60
# Maximum messages per boundary-model call.
ADAPTIVE_CHUNK_MAX_MESSAGES_PER_CALL=80
# Target chunk characters.
ADAPTIVE_CHUNK_TARGET_CHARS=700
# Hard character limit; at least ADAPTIVE_CHUNK_TARGET_CHARS.
ADAPTIVE_CHUNK_MAX_CHARS=1400
# Minimum turns per adaptive chunk.
ADAPTIVE_CHUNK_MIN_TURNS=3
# Overlap turns between adaptive chunks.
ADAPTIVE_CHUNK_OVERLAP_TURNS=2
# Soft time gap used to assist boundaries.
ADAPTIVE_CHUNK_SOFT_GAP_MINUTES=8
# Positive explicitly sets concurrency; 0 uses Label concurrency or falls back to 4.
ADAPTIVE_CHUNK_MAX_CONCURRENCY=0
# Cache inferred boundaries for resumable adaptive chunking.
ADAPTIVE_CHUNK_CACHE_PATH=.data/ingestion/adaptive_chunk_cache.jsonl

# ----- Relationship analysis -----
# OpenAI-compatible block-analysis URL; empty uses the main chat model.
ANALYSIS_API_URL=
# Analysis key; empty uses the main chat key.
ANALYSIS_API_KEY=
# Analysis model; empty uses CHAT_MODEL.
ANALYSIS_MODEL=
# Final relationship-stage, personality, Life and experimental merge URL; empty uses OPENAI_BASE_URL.
ANALYSIS_FINAL_API_URL=
# Final model key; empty uses OPENAI_API_KEY.
ANALYSIS_FINAL_API_KEY=
# Final report/merge model, not a block-failure fallback; empty uses CHAT_MODEL.
ANALYSIS_FINAL_MODEL=
# Block Map and monthly candidate-merge temperature, 0..2.
ANALYSIS_TEMPERATURE=0.3
# Block/monthly structured-output token cap; too low can truncate JSON.
ANALYSIS_MAX_TOKENS=6000
# Final model merge/personality output token cap.
ANALYSIS_FINAL_MAX_TOKENS=6000
# Per-request analysis timeout in seconds; positive.
ANALYSIS_TIMEOUT_SECONDS=120
# Character budget per analysis block.
ANALYSIS_BLOCK_CHAR_BUDGET=10000
# Maximum in-flight block-analysis calls.
ANALYSIS_MAX_CONCURRENCY=3
# Spacing between request starts; 0 adds no delay.
ANALYSIS_REQUEST_INTERVAL_SECONDS=0
# During explicit analyze-proactive only, use the final model to explain opening motives/timing. Up to 12 openings per batch, with prior tail, opening and first response; stable IDs permit attribution reuse.
ANALYSIS_PROACTIVE_ENABLED=true
# Openings per attribution batch, 1..12; smaller reduces JSON truncation risk.
ANALYSIS_PROACTIVE_BATCH_SIZE=4
# Concurrent proactive-attribution batches; at least 1.
ANALYSIS_PROACTIVE_MAX_CONCURRENCY=4
# Inject inferred sleep/meal/activity/availability patterns into Life decisions; real current time and today's state take precedence.
ANALYSIS_LIFE_CONTEXT_ENABLED=false
# Provide evidence-free regular personality context to the main chat model; independent of experimental switches.
ANALYSIS_PERSONALITY_PROMPT_ENABLED=false
# Add a separate experimental Map per block and a global merge; disabled by default.
ANALYSIS_EXPERIMENTAL_ENABLED=false
# Generate an evidence-free, non-diagnostic summary for the main chat model; requires the experimental-generation switch too.
ANALYSIS_EXPERIMENTAL_PROMPT_ENABLED=false

# ----- Hybrid retrieval -----
# Response-pair vector recall count.
RESPONSE_PAIR_TOP_K=24
# Standalone friend-message recall count.
FRIEND_TOP_K=32
# Historical multi-turn window recall count.
WINDOW_TOP_K=16
# Historical VLM image-description recall count.
HISTORY_IMAGE_TOP_K=8
# Live semantic recall count.
LIVE_TOP_K=12
# Maximum fused/reranked candidates injected into the main prompt.
FINAL_CONTEXT_K=12
# Reciprocal Rank Fusion smoothing constant.
RRF_K=60
# Total retrieval budget, including rewrite, embeddings, recall and rerank; positive seconds.
RETRIEVAL_TIMEOUT_SECONDS=15
# Per-path overfetch multiplier to compensate for filtering and deduplication.
RETRIEVAL_OVERFETCH=3
# Time-decay half-life in days.
RECENCY_HALF_LIFE_DAYS=30
# Maximum recency bonus.
RECENCY_MAX_BOOST=0.15
# Warmth-score weighting coefficient.
WARMTH_BOOST=0.12
# Live source weight.
LIVE_SOURCE_WEIGHT=1.08
# Human text-history weight.
HISTORY_SOURCE_WEIGHT=1.0
# Historical image-description fusion weight.
HISTORY_IMAGE_SOURCE_WEIGHT=0.75
# Trust weight for AI-generated live memory.
AI_GENERATED_SOURCE_WEIGHT=0.25
# Allow AI replies in cross-conversation long-term retrieval.
AI_GENERATED_LONG_TERM_ENABLED=false

# ----- Query Rewrite -----
# Rewrite short colloquial messages into retrieval-friendly queries.
QUERY_REWRITE_ENABLED=false
# Rewrite URL; empty prefers the Label chain.
QUERY_REWRITE_API_URL=
# Rewrite model key.
QUERY_REWRITE_API_KEY=
# Rewrite model name.
QUERY_REWRITE_MODEL=
# Rewrite temperature, 0..2.
QUERY_REWRITE_TEMPERATURE=0
# Maximum rewrite output tokens.
QUERY_REWRITE_MAX_TOKENS=240
# Maximum variants including the original query.
QUERY_REWRITE_MAX_VARIANTS=3
# Rewrite timeout in seconds; positive.
QUERY_REWRITE_TIMEOUT_SECONDS=30

# ----- LLM Rerank (experimental) -----
# LLM semantic/style ranking of RRF candidates; usually unsuitable for weak small models.
RERANK_ENABLED=false
# One of auto, always, never.
RERANK_MODE=auto
# LLM reranker URL; empty reuses Policy/Life/main model.
RERANK_API_URL=
# LLM reranker key.
RERANK_API_KEY=
# LLM reranker model.
RERANK_MODEL=
# Ranking temperature, 0..2.
RERANK_TEMPERATURE=0
# Maximum ranking JSON output tokens.
RERANK_MAX_TOKENS=1200
# Candidates supplied to LLM ranking.
RERANK_TOP_K=28
# Minimum candidates before ranking runs.
RERANK_MIN_CANDIDATES=16
# Ranking timeout; failures retain RRF order (fail open).
RERANK_TIMEOUT_SECONDS=30
# Mixing weight between LLM rank and original score, 0..1.
RERANK_WEIGHT=0.55
# Maximum retained candidates from one session.
RERANK_MAX_SAME_SESSION=3

# ----- Cross-encoder Rerank -----
# Use a dedicated cross-encoder before optional LLM ranking.
CROSS_RERANK_ENABLED=false
# jina or dashscope request format.
CROSS_RERANK_PROTOCOL=jina
# Rerank service base URL.
CROSS_RERANK_API_URL=
# Rerank key.
CROSS_RERANK_API_KEY=
# Dedicated reranker name.
CROSS_RERANK_MODEL=
# Candidates passed from RRF to the cross-encoder.
CROSS_RERANK_INPUT_K=48
# Retained candidates; normally at least FINAL_CONTEXT_K.
CROSS_RERANK_TOP_N=16
# Cross-encoder timeout in seconds; positive.
CROSS_RERANK_TIMEOUT_SECONDS=5

# ----- Live writeback -----
# Write new conversations to Live Memory.
WRITEBACK_ENABLED=true
# Asynchronous writeback queue capacity.
WRITEBACK_QUEUE_SIZE=1000
# Per-conversation turns accumulated before batch embedding/storage.
WRITEBACK_BATCH_TURNS=8
# Force flush after this idle interval.
WRITEBACK_FLUSH_INTERVAL_SECONDS=300
# Generate vectors for Live messages; false stores zero vectors excluded from semantic recall.
WRITEBACK_VECTORIZE=true

# ----- Storage, authentication, configuration UI and privacy -----
# Rows per merge_insert batch; smaller reduces memory at a throughput cost. Does not fix vector dimension mismatches.
LANCE_UPSERT_BATCH_SIZE=128
# Rows required before automatic physical indexing; 0 disables it.
LANCE_INDEX_MIN_ROWS=1000

# ----- Debugging and metrics -----
# Expose /debug/*; disable after investigation.
DEBUG_ENDPOINTS_ENABLED=false
# Retain complete prompt/response text in debug records.
DEBUG_MODEL_FULL_PAYLOADS_ENABLED=false
# Ring-buffer capacity for each metric/model-chain record class.
METRICS_CAPACITY=100

# ----- Semantic labels -----
# Enable mood/topic/importance soft labels.
LABELING_ENABLED=false
# OpenAI-compatible labeling URL.
LABEL_API_URL=https://open.bigmodel.cn/api/paas/v4
# Labeling key.
LABEL_API_KEY=
# Labeling model name.
LABEL_MODEL=glm-4-flash
# Labeling timeout in seconds; positive.
LABEL_TIMEOUT_SECONDS=30
# Messages per labeling call.
LABEL_BATCH_SIZE=8
# Concurrent labeling batches; code fallback without .env is 1.
LABEL_MAX_CONCURRENCY=19
# Spacing between request starts; 0 adds no delay.
LABEL_REQUEST_INTERVAL_SECONDS=0
# Reserved field; not consumed by the current pipeline.
LABEL_FLUSH_AFTER_N=20
# Reserved field; not consumed by the current pipeline.
LABEL_FLUSH_INTERVAL_SECONDS=300
# Reserved field; offline labeling currently always processes unlabeled chunks only.
LABEL_INCREMENTAL=true
# Maximum characters of each chunk in a labeling prompt.
LABEL_MAX_CHARS_PER_MESSAGE=200
# Comma-separated custom mood vocabulary; empty uses built-in values.
LABEL_MOOD_VOCAB=

# ----- Schedule extraction -----
# Parse hidden <schedule-hint> output into structured tasks.
SCHEDULE_EXTRACT_ENABLED=false
# Extractor URL; empty follows Label-to-main fallback chain.
SCHEDULE_API_URL=
# Extractor key.
SCHEDULE_API_KEY=
# Extractor model.
SCHEDULE_MODEL=
# Schedule JSON temperature.
SCHEDULE_TEMPERATURE=0.1
# Maximum extraction JSON tokens.
SCHEDULE_MAX_TOKENS=400
# Extractor model timeout in seconds; positive.
SCHEDULE_TIMEOUT_SECONDS=60
# Maximum parsed hints per turn.
SCHEDULE_MAX_HINTS_PER_TURN=5
# Whole-batch budget; failure returns no tasks without blocking the main reply.
SCHEDULE_EXTRACT_TIMEOUT_SECONDS=10
